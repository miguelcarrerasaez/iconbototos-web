# ============================================
# BACKEND - Copia este archivo como .env
# ============================================

# TOKEN DE ACCESO de Mercado Pago (OBLIGATORIO; el servidor no arranca sin él).
# Credenciales de producción: https://www.mercadopago.cl/developers/panel/app
MP_ACCESS_TOKEN=APP_USR-xxxxxxxx-xxxxxxxx-xxxxxxxx-xxxx

# URL pública donde vive este backend. Es a donde Mercado Pago envía el webhook.
# - Producción : https://iconbototos-api.onrender.com
# - Prueba local con ngrok: WEBHOOK_URL=https://xxxx.ngrok-free.app
WEBHOOK_URL=https://iconbototos-api.onrender.com

# URL del frontend a la que Mercado Pago redirige al terminar el pago.
FRONTEND_URL=https://iconbototos-web.vercel.app

# Opcional: solo si usas PostgreSQL (Neon/Render). Si falta, se usa SQLite local.
# DATABASE_URL=postgresql://usuario:password@host:5432/iconbototos
# ============================================
# FRONTEND - Copia este archivo como .env
# ============================================

# Llave PÚBLICA de Mercado Pago (no es secreta).
# Es el mismo par de credenciales que el MP_ACCESS_TOKEN del backend.
# Panel de credenciales: https://www.mercadopago.cl/developers/panel/app
VITE_MP_PUBLIC_KEY=APP_USR-xxxxxxxx-xxxxxxxx-xxxxxxxx-xxxx

# Opcional: sobrescribe la URL del backend cuando NO estás en localhost.
# VITE_BACKEND_URL=https://iconbototos-api.onrender.com